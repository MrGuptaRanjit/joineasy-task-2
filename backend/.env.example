# Server Environment Configuration
NODE_ENV=production
PORT=5000

# Security (Generate a strong random 32+ character string in production)
JWT_SECRET=your_super_secret_jwt_key_academic_nexus_2026_change_in_prod
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection URL (Neon / Supabase / Render / Local)
# Example: postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_nexus

# Frontend Web Application URL for CORS Whitelist
# Set this to your deployed frontend domain (e.g., https://academic-nexus.vercel.app)
FRONTEND_URL=http://localhost:5173
